{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magdox.io/schema/findings-payload.v2.json",
  "title": "MAGDOX findings upload v2",
  "description": "Scan-result upload only. Authentication, rule downloads and AIBOM use separate paths. Snippets require include_code and receiving-project permission. API also validates paths, byte limits, timestamps and unique pass names.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "commit": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "cli_version": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{16,64}$"
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "end_line": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "limits": {
            "type": "string"
          },
          "snippet": {
            "type": "string",
            "maxLength": 512
          },
          "surface": {
            "enum": [
              "sast",
              "iac",
              "sca",
              "secrets",
              "crypto"
            ]
          },
          "package": {
            "type": "string"
          },
          "ecosystem": {
            "type": "string"
          },
          "installed": {
            "type": "string"
          },
          "fixed_in": {
            "type": "string"
          },
          "direct": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 1024
              },
              "remediation": {
                "type": "string",
                "maxLength": 16384
              },
              "cwe": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxItems": 64
              },
              "owasp": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                },
                "maxItems": 64
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2048
                },
                "maxItems": 64
              },
              "flow": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "snippet": {
                      "type": "string",
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "line",
                    "label"
                  ]
                },
                "maxItems": 128
              },
              "advisory": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "epss": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "kev": {
                    "type": "boolean"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "maxItems": 64
                  },
                  "fixed_versions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "maxItems": 128
                  }
                },
                "required": []
              }
            },
            "required": []
          }
        },
        "required": [
          "fingerprint",
          "rule",
          "severity",
          "path",
          "line",
          "surface"
        ]
      },
      "maxItems": 1000000
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "files_failed": {
          "type": "integer",
          "minimum": 0
        },
        "rules_run": {
          "type": "integer",
          "minimum": 0
        },
        "rules_unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_findings_withheld": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "reason": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "path",
              "reason"
            ]
          },
          "maxItems": 128
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "finished_at": {
              "type": "string",
              "format": "date-time"
            },
            "rules_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "advisory_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "advisory_built_at": {
              "type": "string",
              "maxLength": 64
            },
            "include_tests": {
              "type": "boolean"
            },
            "passes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "enum": [
                      "sast",
                      "iac",
                      "sca",
                      "secrets",
                      "sbom",
                      "cbom",
                      "aibom",
                      "malicious"
                    ]
                  },
                  "status": {
                    "enum": [
                      "completed",
                      "partial",
                      "failed",
                      "unsupported",
                      "skipped",
                      "not_requested"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 512
                  }
                },
                "required": [
                  "name",
                  "status"
                ]
              },
              "maxItems": 8,
              "minItems": 8
            }
          },
          "required": [
            "started_at",
            "finished_at",
            "rules_digest",
            "include_tests",
            "passes"
          ]
        }
      },
      "required": [
        "files_scanned",
        "files_skipped",
        "files_failed",
        "rules_run"
      ]
    },
    "include_code": {
      "type": "boolean"
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab",
            "bitbucket"
          ]
        },
        "owner": {
          "type": "string",
          "maxLength": 128
        },
        "repo": {
          "type": "string",
          "maxLength": 128
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "provider",
        "owner",
        "repo",
        "number"
      ]
    },
    "collected": {
      "type": "array",
      "items": {
        "enum": [
          "sast",
          "iac",
          "sca",
          "secrets",
          "crypto"
        ]
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 512
          },
          "version": {
            "type": "string",
            "maxLength": 256
          },
          "ecosystem": {
            "type": "string",
            "maxLength": 64
          },
          "purl": {
            "type": "string",
            "maxLength": 1024
          },
          "direct": {
            "type": "boolean"
          },
          "manifest": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "name",
          "version",
          "ecosystem",
          "purl",
          "direct"
        ]
      },
      "maxItems": 1000000
    },
    "crypto": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "type": "string",
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "maxLength": 64
          },
          "assessment": {
            "type": "string",
            "maxLength": 32
          },
          "quantum_vulnerable": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "line": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "algorithm",
          "kind",
          "assessment",
          "path",
          "line"
        ]
      },
      "maxItems": 1000000
    }
  },
  "required": [
    "version",
    "project",
    "scanned_at",
    "cli_version",
    "findings",
    "coverage",
    "include_code"
  ]
}
